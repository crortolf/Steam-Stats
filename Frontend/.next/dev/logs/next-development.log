idden\":0,\"icon\":\"https://steamcdn-a.akamaihd.net/steamcommunity/public/images/apps/292030/6b5685d92e6435d574e3fc33552ad3d8d4830189.jpg\",\"icongray\":\"https://steamcdn-a.akamaihd.net/steamcommunity/public/images/apps/292030/02afd63cb8659ee0a9b80be913a2e760b4840354.jpg\",\"name\":\"EP2_8\"},{\"defaultvalue\":0,\"displayName\":\"The Grapes of Wrath Stomped\",\"globalPercent\":\"9.5\",\"hidden\":1,\"icon\":\"https://steamcdn-a.akamaihd.net/steamcommunity/public/images/apps/292030/6aa435136c0dd0027b1aaeb4d45039520bad5c11.jpg\",\"icongray\":\"https://steamcdn-a.akamaihd.net/steamcommunity/public/images/apps/292030/660b5a4e2b7ab30169aa977dcc2ec8c414f1d300.jpg\",\"name\":\"EP2_9\"},{\"defaultvalue\":0,\"description\":\"Unlock the bonus for equipping all the witcher gear elements from one School.\",\"displayName\":\"Dressed to Kill\",\"globalPercent\":\"9.6\",\"hidden\":0,\"icon\":\"https://steamcdn-a.akamaihd.net/steamcommunity/public/images/apps/292030/f117ec5bce5ef47bddbf5cd6425a9df1d97bc1f5.jpg\",\"icongray\":\"https://steamcdn-a.akamaihd.net/steamcommunity/public/images/apps/292030/28421516d09ea07f83e2829f3d1c6defc5e347ed.jpg\",\"name\":\"EP2_10\"},{\"defaultvalue\":0,\"description\":\"Develop a mutation.\",\"displayName\":\"Weapon \\\"W\\\"\",\"globalPercent\":\"14.8\",\"hidden\":0,\"icon\":\"https://steamcdn-a.akamaihd.net/steamcommunity/public/images/apps/292030/d03aa746e0bc11026aab5916d0e6663be256ef4c.jpg\",\"icongray\":\"https://steamcdn-a.akamaihd.net/steamcommunity/public/images/apps/292030/488f075e0a75a607ba3c156112140baa7ada14b9.jpg\",\"name\":\"EP2_11\"},{\"defaultvalue\":0,\"displayName\":\"Hasta la Vista™\",\"globalPercent\":\"2.3\",\"hidden\":1,\"icon\":\"https://steamcdn-a.akamaihd.net/steamcommunity/public/images/apps/292030/96b81977f5938a42d86afe8efa87a69e0d302573.jpg\",\"icongray\":\"https://steamcdn-a.akamaihd.net/steamcommunity/public/images/apps/292030/79bde44264f8b2a1c0fb769b8a004edfdbdbc61b.jpg\",\"name\":\"EP2_12\"},{\"defaultvalue\":0,\"displayName\":\"David and Golyat\",\"globalPercent\":\"3.2\",\"hidden\":1,\"icon\":\"https://steamcdn-a.akamaihd.net/steamcommunity/public/images/apps/292030/91928a571176513cf75824dee99f2c3ef6339484.jpg\",\"icongray\":\"https://steamcdn-a.akamaihd.net/steamcommunity/public/images/apps/292030/05313c23663ee15c52d589ee432eb6608ebd39c8.jpg\",\"name\":\"EP2_13\"}],\"description\":\"The Witcher 3: Wild Hunt — Remastered, bu övülen rol yapma oyununu bir dizi yükseltme ve geliştirmeyle günümüze taşıyor. Kiralık canavar avcısı Rivialı Geralt olun ve evlatlık kızınız Ciri'yi bulmak için karanlık fantastik bir açık dünyada destansı bir yolculuğa çıkın.\",\"developers\":[\"CD PROJEKT RED\"],\"icon\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/292030/62fb0a4707d9fb0f729affec7d7d01dd70099769/capsule_184x69_alt_assets_1.jpg?t=1790845156\",\"id\":292030,\"image\":\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/292030/e8afc4252e3fee8ed2525ab2fd7675cca39aa38d/header_alt_assets_1.jpg?t=1790845156\",\"name\":\"The Witcher 3: Wild Hunt — Remastered\",\"publishDate\":\"18 May 2015\",\"publishers\":[\"CD PROJEKT RED\"]}"}
