{"timestamp":"01:09:08.282","source":"Browser","level":"LOG","message":"{\"achievements\":[{\"aId\":\"LILAC\",\"achieved\":1,\"description\":\"\",\"name\":\"Lilac and Gooseberries\",\"time\":\"May 29, 2015\"},{\"aId\":\"FRIEND_IN_NEED\",\"achieved\":1,\"description\":\"\",\"name\":\"A Friend in Need\",\"time\":\"January 24, 2017\"},{\"aId\":\"NECROMANCER\",\"achieved\":1,\"description\":\"\",\"name\":\"Necromancer\",\"time\":\"January 26, 2017\"},{\"aId\":\"FAMILY_COUNSELOR\",\"achieved\":1,\"description\":\"\",\"name\":\"Family Counselor\",\"time\":\"June 7, 2015\"},{\"aId\":\"SOMETHING_MORE\",\"achieved\":1,\"description\":\"\",\"name\":\"Something More\",\"time\":\"March 1, 2017\"},{\"aId\":\"XENONAUT\",\"achieved\":1,\"description\":\"\",\"name\":\"Xenonaut\",\"time\":\"March 2, 2017\"},{\"aId\":\"THE_KING\",\"achieved\":1,\"description\":\"\",\"name\":\"The King is Dead\",\"time\":\"May 26, 2017\"},{\"aId\":\"PASSED_THE_TRIAL\",\"achieved\":1,\"description\":\"Finish the game on any difficulty.\",\"name\":\"Passed the Trial\",\"time\":\"May 26, 2017\"},{\"aId\":\"RAN_THE_GAUNTLET\",\"achieved\":1,\"description\":\"Finish the game on the \\\"Blood and Broken Bones!\\\" or \\\"Death March!\\\" difficulty levels.\",\"name\":\"Ran the Gauntlet\",\"time\":\"May 26, 2017\"},{\"aId\":\"WALKED_THE_PATH\",\"achieved\":1,\"description\":\"Finish the game on the \\\"Death March!\\\" difficulty level.\",\"name\":\"Walked the Path\",\"time\":\"May 26, 2017\"},{\"aId\":\"THE_PROFESSIONAL\",\"achieved\":1,\"description\":\"\",\"name\":\"Geralt: The Professional\",\"time\":\"May 25, 2017\"},{\"aId\":\"MAKER\",\"achieved\":1,\"description\":\"\",\"name\":\"Kingmaker\",\"time\":\"February 16, 2017\"},{\"aId\":\"ASSASSIN\",\"achieved\":1,\"description\":\"\",\"name\":\"Assassin of Kings\",\"time\":\"March 24, 2017\"},{\"aId\":\"FRIENDS_WITH_BENEFITS\",\"achieved\":1,\"description\":\"\",\"name\":\"Friends With Benefits\",\"time\":\"June 1, 2015\"},{\"aId\":\"FULL_CREW\",\"achieve