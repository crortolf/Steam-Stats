{"timestamp":"00:36:54.060","source":"Browser","level":"LOG","message":"{\"achievements\":[{\"aId\":\"DENDROLOGIST\",\"achieved\":0,\"description\":\"Acquire all the Abilities in one tree.\",\"name\":\"Dendrologist\",\"time\":\"December 31, 1969\"},{\"aId\":\"ENEMY_OF_MY_ENEMY\",\"achieved\":0,\"description\":\"Use the Axii Sign to force one opponent to kill another. Do this 20 times.\",\"name\":\"The Enemy of My Enemy\",\"time\":\"December 31, 1969\"},{\"aId\":\"HUMPTY_DUMPTY\",\"achieved\":0,\"description\":\"Kill 10 opponents by knocking them off somewhere high with the Aard Sign.\",\"name\":\"Humpty Dumpty\",\"time\":\"December 31, 1969\"},{\"aId\":\"OVERKILL\",\"achieved\":0,\"description\":\"Make an opponent suffer from bleeding, poisoning and burning simultaneously. Do this 10 times.\",\"name\":\"Overkill\",\"time\":\"December 31, 1969\"},{\"aId\":\"MASTER_MARKSMAN\",\"achieved\":0,\"description\":\"Kill 50 human and nonhuman opponents by striking them in the head with a crossbow bolt.\",\"name\":\"Master Marksman\",\"time\":\"December 31, 1969\"},{\"aId\":\"WHAT_WAS_THAT\",\"achieved\":0,\"description\":\"\",\"name\":\"What Was That?\",\"time\":\"December 31, 1969\"},{\"aId\":\"EVEN_ODDS\",\"achieved\":0,\"description\":\"Kill 2 monsters you have a contract on without using Signs, potions, mutagens, oils or bombs.\",\"name\":\"Even Odds\",\"time\":\"December 31, 1969\"},{\"aId\":\"EP1_3\",\"achieved\":0,\"description\":\"\",\"name\":\"Shopaholic\",\"time\":\"December 31, 1969\"},{\"aId\":\"EP1_4\",\"achieved\":0,\"description\":\"\",\"name\":\"Curator of Nightmares\",\"time\":\"December 31, 1969\"},{\"aId\":\"EP1_5\",\"achieved\":0,\"description\":\"\",\"name\":\"Pacta Sunt Servanda\",\"time\":\"December 31, 1969\"},{\"aId\":\"EP1_6\",\"achieved\":0,\"description\":\"\",\"name\":\"When It's Many Against One…\",\"time\":\"December 31, 1969\"},{\"aId\":\"EP1_7\",\"achieved\":0,\"description\":\"Kill 3 opponents with their own arrows.\",\"name\":\"Return to Sender\",\"time\":\"December 31, 1969\"},{\"aId\":\"EP1_8\",\"achieved\":0,\"description\":\"Be under the influence of seven potions or decoctions at the same time.\",\"name\":\"Can Quit Anytime I Want\",\"time\":\"December 31, 1969\"},{\"aId\":\"EP1_9\",\"achieved\":0,\"description\":\"\",\"name\":\"Wild Rose Dethorned\",\"time\":\"December 31, 1969\"},{\"aId\":\"EP1_10\",\"achieved\":0,\"description\":\"Collect all available Ofieri armor and horse gear, and at least one Ofieri sword.\",\"name\":\"I Wore Ofieri Before It Was Cool\",\"time\":\"December 31, 1969\"},{\"aId\":\"EP1_11\",\"achieved\":0,\"description\":\"\",\"name\":\"Moo-rderer\",\"time\":\"December 31, 1969\"},{\"aId\":\"EP1_12\",\"achieved\":0,\"description\":\"\",\"name\":\"Rad Steez, Bro!\",\"time\":\"December 31, 1969\"},{\"aId\":\"EP1_13\",\"achieved\":0,\"description\":\"Win a round of gwent with a total strength of at least 187.\",\"name\":\"Killed It\",\"time\":\"December 31, 1969\"},{\"aId\":\"EP2_1\",\"achieved\":0,\"description\":\"Travel to the Duchy of Toussaint.\",\"name\":\"The Witcher's Gone South\",\"time\":\"December 31, 1969\"},{\"aId\":\"EP2_3\",\"achieved\":0,\"description\":\"Serve time in Toussaint.\",\"name\":\"Kling of the Clink\",\"time\":\"December 31, 1969\"},{\"aId\":\"EP2_12\",\"achieved\":0,\"description\":\"\",\"name\":\"Hasta la Vista™\",\"time\":\"December 31, 1969\"},{\"aId\":\"EP2_13\",\"achieved\":0,\"description\":\"\",\"name\":\"David and Golyat\",\"time\":\"December 31, 1969\"},{\"aId\":\"LILAC\",\"achieved\":1,\"description\":\"\",\"name\":\"Lilac and Gooseberries\",\"time\":\"May 29, 2015\"},{\"aId\":\"FRIEND_IN_NEED\",\"achieved\":1,\"description\":\"\",\"name\":\"A Friend in Need\",\"time\":\"January 24, 2017\"},{\"aId\":\"NECROMANCER\",\"achieved\":1,\"description\":\"\",\"name\":\"Necromancer\",\"time\":\"January 26, 2017\"},{\"aId\":\"FAMILY_COUNSELOR\",\"achieved\":1,\"description\":\"\",\"name\":\"Family Counselor\",\"time\":\"June 7, 2015\"},{\"aId\":\"SOM