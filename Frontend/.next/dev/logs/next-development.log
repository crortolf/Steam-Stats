d\":1,\"description\":\"\",\"name\":\"Full Crew\",\"time\":\"February 27, 2017\"},{\"aId\":\"DENDROLOGIST\",\"achieved\":0,\"description\":\"Acquire all the Abilities in one tree.\",\"name\":\"Dendrologist\",\"time\":\"December 31, 1969\"},{\"aId\":\"ENEMY_OF_MY_ENEMY\",\"achieved\":0,\"description\":\"Use the Axii Sign to force one opponent to kill another. Do this 20 times.\",\"name\":\"The Enemy of My Enemy\",\"time\":\"December 31, 1969\"},{\"aId\":\"HUMPTY_DUMPTY\",\"achieved\":0,\"description\":\"Kill 10 opponents by knocking them off somewhere high with the Aard Sign.\",\"name\":\"Humpty Dumpty\",\"time\":\"December 31, 1969\"},{\"aId\":\"ENVIRONMENTALLY_UNFRIENDLY\",\"achieved\":1,\"description\":\"Kill 50 opponents using the environment (e.g. swamp gas, insects or objects).\",\"name\":\"Environmentally Unfriendly\",\"time\":\"June 14, 2015\"},{\"aId\":\"KAER_MORHEN_TRAINED\",\"achieved\":1,\"description\":\"Perform 10 effective counterattacks in a row without getting hit or parrying.\",\"name\":\"Kaer Morhen Trained\",\"time\":\"January 25, 2017\"},{\"aId\":\"CANT_TOUCH_THIS\",\"achieved\":1,\"description\":\"Kill 5 foes in a fight without taking damage (except for Toxicity) and without using the Quen Sign.\",\"name\":\"Can't Touch This!\",\"time\":\"June 7, 2015\"},{\"aId\":\"THE_EVILEST_THING\",\"achieved\":1,\"description\":\"Ignite the gas produced by a Dragon's Dream bomb using a burning opponent. Do this 10 times.\",\"name\":\"That Is the Evilest Thing\",\"time\":\"January 26, 2017\"},{\"aId\":\"MUTANT\",\"achieved\":1,\"description\":\"Fill all mutagen slots.\",\"name\":\"Mutant\",\"time\":\"March 1, 2017\"},{\"aId\":\"BUTCHER_OF_BLAVIKEN\",\"achieved\":1,\"description\":\"Kill at least 5 opponents in under 10 seconds.\",\"name\":\"Butcher of Blaviken\",\"time\":\"June 1, 2015\"},{\"aId\":\"TRIPLE_THREAT\",\"achieved\":1,\"description\":\"\",\"name\":\"Triple Threat\",\"time\":\"May 27, 2015\"},{\"aId\":\"BRAWLER\",\"achieved\":1,\"description\":\"Defeat Olaf, the Skellige champion of unarmed combat.\",\"name\":\"Brawler\",\"time\":\"February 27, 2017\"},{\"aId\":\"OVERKILL\",\"achieved\":0,\"description\":\"Make an opponent suffer from bleeding, poisoning and burning simultaneously. Do this 10 times.\",\"name\":\"Overkill\",\"time\":\"December 31, 1969\"},{\"aId\":\"MASTER_MARKSMAN\",\"achieved\":0,\"description\":\"Kill 50 human and nonhuman opponents by striking them in the head with a crossbow bolt.\",\"name\":\"Master Marksman\",\"time\":\"December 31, 1969\"},{\"aId\":\"WHAT_WAS_THAT\",\"achieved\":0,\"description\":\"\",\"name\":\"What Was That?\",\"time\":\"December 31, 1969\"},{\"aId\":\"EVEN_ODDS\",\"achieved\":0,\"description\":\"Kill 2 monsters you have a contract on without using Signs, potions, mutagens, oils or bombs.\",\"name\":\"Even Odds\",\"time\":\"December 31, 1969\"},{\"aId\":\"GLOBETROTTER\",\"achieved\":1,\"description\":\"Discover 100 fast travel points.\",\"name\":\"Globetrotter\",\"time\":\"July 21, 2016\"},{\"aId\":\"PEST_CONTROL\",\"achieved\":1,\"description\":\"Destroy all monster nests in the Velen / Novigrad region, or in Skellige.\",\"name\":\"Pest Control\",\"time\":\"February 16, 2017\"},{\"aId\":\"CARD_COLLECTOR\",\"achieved\":1,\"description\":\"Acquire all gwent cards available in the base version of the game.\",\"name\":\"Card Collector\",\"time\":\"February 27, 2017\"},{\"aId\":\"GWENT_MASTER\",\"achieved\":1,\"description\":\"Defeat Tybalt and win the gwent tournament held at the Passiflora.\",\"name\":\"Gwent Master\",\"time\":\"January 25, 2017\"},{\"aId\":\"LETS_COOK\",\"achieved\":1,\"description\":\"Learn 12 potion formulae.\",\"name\":\"Let's Cook!\",\"time\":\"May 28, 2015\"},{\"aId\":\"BOMBARDIER\",\"achieved\":1,\"description\":\"Collect the formulae for 6 different bomb types.\",\"name\":\"Bombardier\",\"time\":\"May 31, 2015\"},{\"aId\":\"BOOKWORM\",\"achieved\":1,\"description\":\"Read 30 books, journals or other documents.\",\"name\":\"Bookworm\",\"time\":